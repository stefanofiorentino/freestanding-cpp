---
# Project clang-format style (C++23). Run from the targets:
#   cmake --build build --target format
# or manually: clang-format -i src/*.hpp src/*.cpp test/*.cpp
BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
SortIncludes: CaseSensitive
# Note: clang-format's Standard enum only goes up to c++20; the C++23
# standard for the build is set via compile flags in CMakeLists.txt.
...
